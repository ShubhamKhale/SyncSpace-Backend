PORT=8080
GIN_MODE=release
REDIS_URL=redis://default:password@host:port
DB_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=replace_with_a_long_random_secret

# Email (Brevo) — leave BREVO_API_KEY empty to disable email sending
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@syncspace.app
BREVO_FROM_NAME=SyncSpace
FRONTEND_URL=http://localhost:3000

# Cloudinary — leave CLOUDINARY_CLOUD_NAME empty to disable avatar upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Ollama — local model server for AI chat/summarization in dev (run `ollama serve`)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Groq — cloud LLM for prod (deployed backends have no local Ollama to call).
# Leave empty locally to use Ollama; set in production (e.g. Render) to use Groq instead.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
