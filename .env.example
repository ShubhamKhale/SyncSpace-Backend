# ── Core (required) ───────────────────────────────────────────────────────────
PORT=8080
GIN_MODE=release
# PostgreSQL connection string (Neon, Supabase, RDS or local Postgres 14+)
DB_URL=postgresql://user:password@host/dbname?sslmode=require
# Long random string — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=replace_with_a_long_random_secret
# Public URL of the frontend — used for CORS and invite links (no trailing slash)
FRONTEND_URL=http://localhost:3000

# ── Real-time collaboration (optional) ───────────────────────────────────────
# Live cursors, presence, voting sync and presenter mode need Redis.
# Leave empty to run without the WebSocket hub (everything else works).
REDIS_URL=redis://default:password@host:port

# ── Email invites via Brevo (optional) ───────────────────────────────────────
# Leave BREVO_API_KEY empty to disable email sending (invites are still created).
# BREVO_FROM_EMAIL must be a verified sender in Brevo.
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@example.com
BREVO_FROM_NAME=SyncSpace

# ── Avatar uploads via Cloudinary (optional) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI (optional) ────────────────────────────────────────────────────────────
# Groq powers board chat, summarize and diagram generation in production.
# Without GROQ_API_KEY, chat/summarize use a local Ollama server and diagram
# generation is disabled.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Diagram generation tries GROQ_DIAGRAM_MODEL, then each fallback in order
# (each Groq model has its own rate limit). Default fallbacks:
#   $GROQ_MODEL,qwen/qwen3.8-27b
GROQ_DIAGRAM_MODEL=openai/gpt-oss-120b
GROQ_DIAGRAM_FALLBACKS=
# Server-side kill switch for the "Search the web" option (users opt in per request)
GROQ_DIAGRAM_WEB_SEARCH=true

# Local AI for development (run `ollama serve`)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
